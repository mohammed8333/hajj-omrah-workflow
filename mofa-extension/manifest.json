{
  "manifest_version": 3,
  "name": "مساعد استعلام تأشيرات وزارة الخارجية (MOFA Helper)",
  "version": "1.0.0",
  "description": "إضافة ذكية لتعبئة بيانات المسافر آلياً والتقاط وربط التأشيرة بنظام إدارة رحلات العمرة",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://visa.mofa.gov.sa/*",
        "*://*.visa.mofa.gov.sa/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
